# Copie para .env.local (dev) ou configure como secrets no Coolify (prod).
# Ver docs/STACK.md §5.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# gere com: openssl rand -base64 32
AUTH_SECRET=
# necessário em produção atrás de proxy (Traefik/Coolify)
AUTH_TRUST_HOST=true
# MFA (verificação em duas etapas): "true" = obrigatório; ausente/qualquer
# outro valor = standby (fase de testes, login só com e-mail+senha).
MFA_ENFORCED=
# Super-admins da plataforma (podem criar/gerenciar contas/tenants em
# /plataforma). Lista de e-mails separada por vírgula. OBRIGATÓRIO para usar o
# console da plataforma: sem ela, ninguém é operador (não há e-mail no código).
#   SUPERADMIN_EMAILS=operador@exemplo.com,outro.operador@exemplo.com
SUPERADMIN_EMAILS=

# Seed de DEMONSTRAÇÃO (opcional; `npm run db:seed`). Cria uma empresa fictícia.
# Recusa NODE_ENV=production, salvo SEED_DEMO_EM_PRODUCAO=sim. Sem senha
# informada, gera uma aleatória e mostra uma vez (troca obrigatória no 1º acesso).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Postgres (interno do Coolify em produção)
DATABASE_URL=postgresql://user:pass@localhost:5432/growthtools

# Redis (filas BullMQ / cache — Fase 4+)
REDIS_URL=redis://localhost:6379

# Cloudflare R2 (S3-compatível) — repositório de documentos (Fase 3)
R2_ENDPOINT=https://__account_id__.r2.cloudflarestorage.com
R2_BUCKET=documentos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# opcional: domínio público/custom do bucket
R2_PUBLIC_URL=

# Open Finance (Pluggy) — Fase 4
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Prompt AT §1-B — "sandbox" (padrão: o widget mostra os bancos de teste da Pluggy) ou "producao".
PLUGGY_ENV=sandbox
# Segredo do cabeçalho x-webhook-secret que a Pluggy manda no webhook (registre com scripts/openfinance-webhook.ts).
PLUGGY_WEBHOOK_SECRET=
# Segredo do cabeçalho x-cron-secret da sincronização diária (/api/openfinance/sync), usado pelo agendador do Coolify.
OPENFINANCE_CRON_SECRET=

# Emissão de NFS-e (Focus NFe) — ver docs/EMISSAO-NF.md.
# Token da EMPRESA gerado no painel do provedor, um por ambiente. É enviado como
# usuário do HTTP Basic (senha vazia) — trate como secret: quem tem o token
# emite nota em nome da empresa.
# FOCUS_NFE_TOKEN vale como fallback quando o token do ambiente não está
# definido. Sem token, o app calcula e valida a nota mas não envia nada.
FOCUS_NFE_TOKEN_HOMOLOGACAO=
FOCUS_NFE_TOKEN_PRODUCAO=
FOCUS_NFE_TOKEN=

# IA — leitura de documentos (NF/boleto/cupom/comprovante) para preencher
# despesas e cadastros (Anthropic/Claude).
# Sem esta chave, o upload/vínculo do documento funciona, mas a leitura
# automática por IA fica desabilitada. Ver src/lib/ai/despesa-extract.ts.
# A chave sozinha não basta: a conta precisa ter CRÉDITOS (o uso é cobrado por
# token). Sem saldo, a API responde 400 e o Diagnóstico de IA mostra o motivo.
ANTHROPIC_API_KEY=

# Só para chave VINCULADA A IDENTIDADE (criada para uma service account no
# Console): esse tipo de chave exige informar em qual workspace a requisição
# age. Preencha com o ID do workspace (console.anthropic.com → Settings →
# Workspaces, começa com wrkspc_). Chave comum: deixe vazio.
ANTHROPIC_WORKSPACE_ID=

# Modelo usado nas leituras. OPCIONAL — sem isto o app usa claude-haiku-4-5,
# o mais barato, que dá conta de PDF nítido (DANFE, comprovante de Pix, boleto).
# Aceita o IDENTIFICADOR do modelo, não o nome comercial:
#   claude-haiku-4-5   (padrão — mais barato)
#   claude-sonnet-5    (meio-termo)
#   claude-opus-5      (mais caro; melhor em foto amassada/papel desbotado)
#   claude-opus-4-8
# Suba um degrau se a leitura de FOTO vier fraca — o custo por documento é de
# centavos em qualquer um deles, e o que a IA não entender continua aparecendo
# como alerta de campo na tela, para conferência.
# "Sonnet 5" (com espaço/maiúscula) NÃO é um identificador — o app traduz e
# avisa na tela de Diagnóstico de IA, mas o certo é gravar o id aqui.
# Ver src/lib/ai/modelos.ts.
ANTHROPIC_MODEL=

# ─────────────────────── API de agente (Cris / WhatsApp) ───────────────────────
# Segredo compartilhado entre esta app e o cofre da fazer.ai. Prova que quem
# chama /api/agent/* é o runtime do agente, e não alguém que descobriu a URL.
# VAZIO = a API de agente fica DESLIGADA (responde 503). É o default seguro.
#   openssl rand -base64 48
AGENT_API_TOKEN=

# Allowlist: quem pode consultar o Growth pelo WhatsApp. Formato
# telefone=email, separados por vírgula. O e-mail precisa ser de um usuário
# existente do Growth — é dele que saem tenant, perfil e permissões, as MESMAS
# das telas. Número fora desta lista leva 403 no servidor, independentemente do
# que o agente tenha sido convencido a fazer.
#   +5511900000001=operador@exemplo.com, +5511900000002=gestor@exemplo.com
AGENT_ALLOWED_PHONES=
